<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../GameReferences.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
    <Compile Remove="JsonUtilityStub.cs" />
    <None Include="../Examples/RaidDocks/Localization/en.csv" Link="Fixtures/en.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Examples/RaidDocks/pack.json" Link="Fixtures/pack.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../RaidEntry.cs" Link="Production/RaidEntry.cs" />
    <Compile Include="../RaidGraphic.cs" Link="Production/RaidGraphic.cs" />
    <Compile Include="../RaidModel.cs" Link="Production/RaidModel.cs" />
    <Compile Include="../Vec2.cs" Link="Production/Vec2.cs" />
    <Compile Include="../Content.cs" Link="Production/Content.cs" />
    <Compile Include="../DefaultContent.cs" Link="Production/DefaultContent.cs" />
    <Compile Include="../VisualBridge.cs" Link="Production/VisualBridge.cs" />
    <Compile Include="../ContentBridge.cs" Link="Production/ContentBridge.cs" />
    <Compile Include="../ContentLoader.cs" Link="Production/ContentLoader.cs" />
  </ItemGroup>
</Project>
